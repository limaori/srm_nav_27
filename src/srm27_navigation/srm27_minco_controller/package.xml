<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>srm27_minco_controller</name>
  <version>0.1.0</version>
  <description>
    SRM 全向底盘的 Nav2 FollowPath 控制器插件：MINCO 局部轨迹优化 + 全向 MPC 跟踪。
    控制线程负责状态适配、地图快照/ESDF、跟踪参考与 QP；后台线程负责前端初值、
    两阶段 MINCO 与独立轨迹验证。插件不直连串口/Gazebo，正常速度只经 Nav2 出口。
  </description>
  <maintainer email="srm27@example.com">SRM27 Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_common</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>srm27_minco_core</depend>
  <depend>srm27_minco_vendor</depend>
  <depend>srm27_qpoases_vendor</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_clang_tidy</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/srm27_minco_controller.xml" />
  </export>

</package>
