<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateRecovery"
                  number_of_retries="10">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="3.0">
          <!-- number_of_retries: 1 -> 3（2026-11-04）。只重试 1 次时，全局规划连失败两次
               （3 Hz 下约 0.6~1 s）就会让 PipelineSequence 整体失败，行为树随即取消 FollowPath
               并进入自己的 recovery；而控制器内部脱困（链路 A）的窗口是 recovery.window_sec = 3 s，
               实测它常只跑到 1.8 s 就被掐断（2026-11-04 14:19:03：净空 0.341 m 进入，1.8 s 后被取消，
               随后会话还被停滞看门狗作废）。重试 3 次给链路 A 留出完整窗口；代价是全局规划确属失败时
               晚约 1~2 s 才进 clear-costmap + backup，这段延迟由恢复行为兜底。 -->
          <RecoveryNode name="ComputePathThroughPoses"
                        number_of_retries="3">
            <ReactiveSequence>
              <!-- radius 是"离车多近就把这个航点当成已到达并从列表里删掉"的半径(nav2 默认 0.5)。
                   改动史与约束(它和 goal 容差、航点间距、控制器前瞻是一组, 别单独调):
                     - 0.7: 车旁边 0.7 m 内的航点被静默删掉, 车不会去, 但整段
                       navigate_through_poses 仍报成功(reached), 像"没到就说到了"。
                     - 0.25: 车切内弯擦过途经点(偏离量常 >0.25 m)时删不掉它, 下一个
                       3 Hz 周期重规划又把路径绕回该点 → 车折返, 反复后进度检查器判
                       "Failed to make progress"。配合控制器前瞻收紧(0.6/0.3/0.6)后放宽到 0.35。
                     - 约束: radius < general_goal_checker.xy_goal_tolerance(实车 0.4),
                       否则最后一个航点会在判定到达前被删、车掉头往回走;
                       radius < 航点间距, 否则连下一个航点一起被删;
                       radius > 车实际擦过航点的偏移量, 否则折返。 -->
              <RemovePassedGoals input_goals="{goals}"
                                 output_goals="{goals}"
                                 radius="0.35"/>
              <ComputePathThroughPoses goals="{goals}"
                                       path="{path}"
                                       planner_id="GridBased"/>
            </ReactiveSequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode name="FollowPath"
                      number_of_retries="10">
          <FollowPath path="{path}"
                      controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <!-- 同 navigate_to_pose 那份: 脱困速度 0.2 -> 1.5 m/s（2026-11-04, 与仿真/实车同值）。
               该动作由 srm27_nav_behaviors/BackUpFreeSpace 实现, 不是真倒车,
               而是朝最空方向开, 并且绕过 velocity_smoother 的限速。 -->
          <!-- backup_dist / backup_speed / time_allowance 三个端口**仍然是活的**, 别删:
               2026-11-04 曾以为"提前退出"上线后它们没用了, 其实 back_up_free_space 里
                 backup_speed -> 逃逸速度大小 (cos/sin(角度) x speed), 恒定输出;
                 backup_dist  -> ① 走满它才算备份成功; ② 父类 isCollisionFree 用它决定
                                 "还要往前预演多远"做碰撞检查;
                 time_allowance -> 硬超时(默认 10 s)。
               删掉它们会退回 BT 端口默认值 0.15 m / 0.025 m/s, 于是:
                 ① 每次只挪 0.15 m, 基本没用;
                 ② 更致命 —— 我们新加的提前退出有 early_exit_min_travel = 0.30 m 的前置门坎,
                    0.15 m 永远跨不过去, 提前退出会**静默失效**, 行为退回"盲推到底"。
               三个数只在"提前退出没触发"时(比如真被三面围住)才决定全过程, 它们是兜底包络。 -->
          <!-- backup_speed: 0.2 -> 1.5 -> **1.0**（2026-11-04 定稿；仿真与实车共用本文件，
               所以两边同值；与 recovery.escape_speed 一致，两条链路同一节奏）。
               必须同时知道的三件事：
               1) 1.0 m / 1.0 m/s = **1.0 s** 走满 —— 正好等于 behavior_server 的
                  early_exit_min_time(1.0 s)，而距离判定又排在提前退出之前，所以
                  **正常情况（车没被顶住）几乎不会触发提前退出**，备份会走满 1.0 m。
                  提前退出只在"被顶住、位移推不动"时才真正生效 —— 那正是它要救的场景，
                  此时 1.0 m/s 会一直顶到 10 s 超时或净空恢复为止。
               2) 该动作**绕过 velocity_smoother**（直接进 cmd_vel_nav 出口），1.0 m/s 是
                  阶跃式给到底盘的，没有加速斜坡。mux 合速度上限 6.0 m/s 能过。
               3) 父类的碰撞预演按 simulate_ahead_time(2.0 s) x 当前速度向前模拟，但以剩余
                  距离封顶：0.2 m/s 时只看 0.4 m，1.0 m/s 时看满 1.0 m —— 窄处更容易直接判
                  "Collision Ahead" 并返回 FAILED（安全的一侧，但会表现为"备份经常失败"）。 -->
          <BackUp backup_dist="1.0"
                  backup_speed="1.0"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
