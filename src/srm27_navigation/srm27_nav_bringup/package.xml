<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>srm27_nav_bringup</name>
  <version>1.3.2</version>
  <description>srm27_nav_bringup</description>
  <maintainer email="lihanchen2004@163.com">Lihan Chen</maintainer>
  <license>Apache-2.0</license>
  <author email="lihanchen2004@163.com">Lihan Chen</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>navigation2</build_depend>
  <build_depend>nav2_common</build_depend>
  <build_depend>launch_ros</build_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>srm27_nav_plugins</exec_depend>
  <exec_depend>srm27_robot_description</exec_depend>
  <exec_depend>srm27_chassis_control</exec_depend>
  <exec_depend>srm27_gazebo_simulator</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>srm27_navigation</exec_depend>
  <exec_depend>srm27_teleop_twist_joy</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>point_lio</exec_depend>
  <exec_depend>loam_interface</exec_depend>
  <!-- 仿真 LIO 前端替换 Z-LIO（方案 §6.2）：zlio 前端节点 + 它的消息接口。
       zlio_bridge.py 订阅 localization_interfaces/msg/FrontendFrame|FrontendSession；
       tf2_sensor_msgs 在下面已经有了，不需要加。 -->
  <exec_depend>frontend</exec_depend>
  <exec_depend>localization_interfaces</exec_depend>
  <!-- zlio_bridge 用 sensor_msgs_py.point_cloud2 给 ZLIO 的 xyz-only 点云补 intensity 字段
       （否则 terrain_analysis 的 PCL 转换会每条消息刷 "Failed to find match for field
       'intensity'"）。python3-numpy 由它带入。 -->
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>sensor_scan_generation</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>terrain_analysis</exec_depend>
  <exec_depend>terrain_analysis_ext</exec_depend>
  <!-- Omni 控制器：迁移期保留为 A/B 对照与回退；正式切换完成后按方案 §12.3 移除。 -->
  <exec_depend>srm27_omni_pid_controller</exec_depend>
  <!-- MINCO + MPC 迁移新增：核心算法库与 FollowPath 控制器插件。 -->
  <exec_depend>srm27_minco_core</exec_depend>
  <exec_depend>srm27_minco_controller</exec_depend>
  <exec_depend>srm27_minco_vendor</exec_depend>
  <exec_depend>srm27_qpoases_vendor</exec_depend>
  <exec_depend>small_gicp_relocalization</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
