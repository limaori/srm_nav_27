<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>srm27_nav_planner</name>
  <version>0.1.0</version>
  <description>
    SRM27 轨迹规划前端：Nav2 GlobalPlanner 插件 srm27_nav_planner::YAstarGlobalPlanner。
    上游 T-DT YAstar（分层 Mask 的 A*）源码内置于本包 vendor/（MIT），
    插件包装层为本工作区 Apache-2.0。
  </description>
  <maintainer email="srm27@example.com">SRM27 Navigation Team</maintainer>
  <!-- 包装层（include/、src/、test/、CMakeLists.txt、package.xml）Apache-2.0；
       vendor/** 为上游 T-DT tdt-nav-kit 的 MIT 代码，见 THIRD_PARTY_NOTICES.md。 -->
  <license>Apache-2.0</license>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <exec_depend>eigen</exec_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>srm27_nav_common</depend>
  <depend>srm27_map_adapter</depend>
  <depend>srm27_map_core</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
