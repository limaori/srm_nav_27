<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="rmul_supply">
    <WhileDoElse>
      <IsRfidDetected friendly_supply_zone_exchange="false"
                      friendly_supply_zone_non_exchange="true"
                      center_gain_point="false"
                      friendly_fortress_gain_point="false"
                      key_port="{@referee_rfidStatus}"/>
      <RetryUntilSuccessful num_attempts="-1">
        <IsStatusOK ammo_min="0"
                    heat_max="100"
                    hp_min="399"
                    key_port="{@referee_robotStatus}"/>
      </RetryUntilSuccessful>
      <Sequence>
        <SendNav2Goal goal="0;0;0"
                      action_name="navigate_to_pose"/>
        <Sleep msec="500"/>
      </Sequence>
    </WhileDoElse>
  </BehaviorTree>

  <BehaviorTree ID="test_attacked_feedback">
    <KeepRunningUntilFailure>
      <WhileDoElse>
        <IsAttacked gimbal_yaw="{gimbal_yaw}"
                    gimbal_pitch="{gimbal_pitch}"
                    key_port="{@referee_robotStatus}"/>
        <Sequence>
          <PublishGimbalAbsolute topic_name="cmd_gimbal"
                                 duration="500"
                                 gimbal_yaw="{gimbal_yaw}"
                                 gimbal_pitch="{gimbal_pitch}"/>
          <PublishTwist v_y="0.0"
                        v_yaw="3.14"
                        v_x="0.0"
                        duration="2000"
                        topic_name="cmd_vel"/>
          <PublishTwist v_y="0.0"
                        v_yaw="0.0"
                        v_x="1.0"
                        duration="1000"
                        topic_name="cmd_vel"/>
          <PublishTwist v_y="0.0"
                        v_yaw="3.14"
                        v_x="1.0"
                        duration="1000"
                        topic_name="cmd_vel"/>
        </Sequence>
        <AlwaysSuccess/>
      </WhileDoElse>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="test_gimbal_absolute">
    <PublishGimbalAbsolute topic_name="cmd_gimbal"
                           duration="5.0"
                           gimbal_yaw="-1.57"
                           gimbal_pitch="1.0"/>
  </BehaviorTree>

  <BehaviorTree ID="test_gimbal_velocity">
    <PublishGimbalVelocity duration="5.0"
                           yaw_min="-1.57"
                           pitch_min="-0.3"
                           yaw_max="1.57"
                           pitch_max="0.3"
                           gimbal_vel_yaw="1.5"
                           topic_name="cmd_gimbal"
                           gimbal_vel_pitch="1.0"/>
  </BehaviorTree>

  <BehaviorTree ID="test_go_to_supply">
    <Repeat num_cycles="-1">
      <WhileDoElse>
        <IsStatusOK ammo_min="0"
                    heat_max="350"
                    hp_min="350"
                    key_port="{@referee_robotStatus}"/>
        <Sequence>
          <SendNav2Goal goal="3;0;0"
                        action_name="navigate_to_pose"/>
          <Sleep msec="500"/>
        </Sequence>
        <SubTree ID="rmul_supply"/>
      </WhileDoElse>
    </Repeat>
  </BehaviorTree>

  <!-- ==================================================================
       自转转速测试（dev）：只看 Nav2 导航状态调整 wz，不自己下发目标。
       只用于空场或仿真标定，禁止在正式比赛选择。

         test_spin_speed :
           没有活动目标（!nav_action_active）、到点（nav_action_arrived）
           或目标被取消/中止 -> 原地 5 rad/s；
           Nav2 目标 ACCEPTED/EXECUTING -> 导航中 2 rad/s。

       目标请用 RViz “Nav2 Goal” 或其他节点直接发给 navigate_to_pose；
       服务端订阅 <nav_action_name>/_action/status（默认 navigate_to_pose），
       外部目标同样能识别。转速 5.0 / 2.0 写死在树里，不受 spin.* 热调参数
       影响；实际出口仍受 srm_cmd_mux 的 wz_max / wz_ramp 限幅。
       入口：start_real_nav.sh / start_sim_nav.sh 的 test-behavior 参数
       （mux 不要求决策许可）；启动方式与观测见包 README。
       ================================================================== -->
  <BehaviorTree ID="test_spin_speed">
    <KeepRunningUntilFailure>
      <ReactiveSequence>
        <Script code="@motion_allowed := true; @decision_mode := 'test'; @decision_reason := 'nav_action_spin'"/>
        <Fallback name="TestSpinProfile">
          <Sequence name="AtGoalOrNoGoalFastSpin">
            <ScriptCondition code="!@nav_action_active || @nav_action_arrived"/>
            <PublishRotationCmd _successIf="@dry_run"
                                spin_speed="5.0"
                                spin_mode="TEST_HOLD_FAST"
                                topic_name="rotation_cmd"/>
          </Sequence>
          <PublishRotationCmd _successIf="@dry_run"
                              spin_speed="2.0"
                              spin_mode="TEST_MOVING_SLOW"
                              topic_name="rotation_cmd"/>
        </Fallback>
      </ReactiveSequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

</root>
