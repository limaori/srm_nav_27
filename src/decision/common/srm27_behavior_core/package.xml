<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>srm27_behavior_core</name>
  <version>0.1.0</version>
  <description>
    SRM27 决策模块的共享底座（header-only）：航点/语义区加载、导航到点状态、
    自转参考曲线、姿态预算状态。不注册 BehaviorTree 插件、不启动 ROS 节点，
    由决策服务端 srm27_behavior 与 BT 插件包 srm27_behavior_plugins 共用。
  </description>
  <maintainer email="srm27@example.com">SRM27 Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
