<?xml version="1.0"?>
<!-- 声明前后端消息与服务接口的生成及运行依赖。 -->
<package format="3">
  <name>localization_interfaces</name>
  <version>0.0.1</version>
  <description>前后端共享的同步观测、会话身份和重置协议。</description>

  <maintainer email="zhujunheng2005@gmail.com">mozihe</maintainer>
  <author email="zhujunheng2005@gmail.com">mozihe</author>
  <license>GPL-2.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
