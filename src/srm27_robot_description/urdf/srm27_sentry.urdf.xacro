<?xml version="1.0"?>
<!--
  ============================================================================
  srm27_sentry.urdf.xacro —— SRM 哨兵**唯一**车体模型（所有链路共用这一份）
  ============================================================================

  几何数值全部取自 SRM全向轮哨兵.STEP 的 CAD 实测。数值的**权威来源**是
  config/srm27_sentry_geometry.yaml（仿真 SDF 由它生成）；
  两者的数值一致性由 test/test_model_builder.py 的一致性用例强制保证 ——
  改尺寸必须两处一起改，否则测试会直接失败。

  谁在用这一份:
    · 实车建图   real_mapping_launch.py
    · 实车导航   real_robot_state_publisher_launch.py
    · 独立调试   standalone_robot_state_publisher_launch.py
    · 仿真显示   model_builder.build_urdf()（Gazebo 的 SDF 仍由同一份 YAML 生成）
    · 只看模型   viz/srm_sentry_new.launch.py

  ┌──────────────────────────────┐
  │  ●            <- 黑点 = 雷达（可选，带示意支架）
  │ ▁▁▁▁▁         <- 小圆柱 = gimbal_yaw（纯示意，use_yaw 可关）
  │ ████████      <- 大圆柱 = 底盘 (base_link)
  │  ○    ○       <- 4 个小轮 = wheel_*（对角 X 型全向轮）
  └──────────────────────────────┘

  ============================ 怎么看出"在不在转" ============================
  上下两个圆柱都是**绕 z 轴的旋转体**——光秃秃的圆柱转起来，RViz/Gazebo 里看着
  一动不动。所以两个圆柱都带一组**不对称旋转标记**（show_rotation_marks，默认开），
  挂在两条 display-only link 上（chassis_mark / gimbal_mark，fixed，无惯性无碰撞）：

    · *_mark_stripe  侧壁竖条 ：+x 方向一条亮色带（底盘红、云台蓝），
                                抬高 5~6 mm 贴在外壁上 —— 侧面看它扫过 = 在转
    · *_mark_tick    顶面刻线 ：沿 +x 的一根"时针"，俯视看最清楚
    · *_mark_dot     顶面小球 ：刻线末端一颗定位球，缩得很小时也认得出来

  三个标记全部朝 +x（车头）：两圈标记对齐 = 底盘与云台零位对齐；云台转了一定
  跟底盘错开一个角度。尺寸全部由 chassis_radius/yaw_radius 派生，改半径自动跟着走。
  ⚠ 标记只有 visual、没有 collision：不改导航 footprint，也不影响 Gazebo 动力学。
  ⚠ 为什么另开一条 link：RViz2 的 RobotModel 对每条 link 只用**第一个 visual 的
    材质**上色，混进 base_link 就被涂成底盘灰、红蓝全废（实测过）；Gazebo 是按
    visual 上材质的，所以 model_builder 的 SDF 仍把标记画在原来的 link 上。
  设 show_rotation_marks:=false 就退回原来的光圆柱（两条 link 一起消失）。

  ============================ 可被 launch 覆盖的参数 ============================

  坐标系契约（谁决定 TF 长什么样）
    root_frame         base_link | base_footprint        默认 base_link
        base_link : 根坐标系就是 base_link，且**原点在地面**（轮底 = 0）。
                    这是导航契约：base_link 随底盘自转，odom -> base_link 直接
                    指向它，nav2 的 robot_base_frame / Point-LIO / 真值里程计全都
                    按"原点到地面的那个系"写。
        base_footprint : CAD 装配体原样，base_footprint 在地面、base_link 离地
                    0.1009 m。**只有**想按 CAD 原稿看模型时才用；导航链路若用它，
                    base_link 就会同时有 base_footprint 和 odom 两个父节点
                    （tf2 里一个 frame 只能有一个父节点），必须连带改
                    nav2 / sensor_scan_generation / point_lio 的 base frame 约定。
    wheel_joint_type   fixed | continuous                 默认 fixed
        fixed      : 实车链路用。实车没有任何节点发布 /joint_states，用连续关节
                     会让 robot_state_publisher 拿不到轮子 TF，RViz 报
                     "No transform from [wheel_*]" 且不画轮子。
        continuous : 仿真链路用。Gazebo 按 SDF 的关节名发 /joint_states，
                     两侧关节名必须一致（见 model_builder 与一致性测试）。
    gimbal_joint_type  fixed | revolute                   默认 fixed
        云台只是示意包络。实车没人发云台角，用 revolute 会缺 TF；真接云台驱动
        并且有 /joint_states 时才改成 revolute。
    lidar_link_name    字符串                             默认 livox_frame
        实车链路依赖 livox_frame 这个名字（雷达驱动 frame_id、Point-LIO 的
        frame_id、launch 把 livox_imu / livox_scan 挂到它下面）；
        仿真链路用 front_mid360（ros_gz_bridge 与点云链路依赖，见几何 YAML）。
    lidar_xyz          "x y z" 米，**base_link 系（地面 = 0），云台零位下测得**
        注意：即使 root_frame=base_footprint，这里仍然按"地面为 0"给，
        本文件会自己把 z 折算到当前根坐标系下。
        雷达的 parent 是 gimbal_yaw，所以实际 origin 会自动换算成"相对云台"的量
        （z 减去底盘顶面 0.26805）。换云台也换不到这个数：它只跟云台零位有关。
    lidar_roll / lidar_pitch / lidar_yaw   弧度            默认 30° / 0 / 63°
        ⚠ 这个 roll 会直接决定 Point-LIO 的重力方向（real_mapping_launch.py 按
          lidar_rpy 现算 gravity）。改这里必须同时改 nav2 参数里的 gravity。
    lidar_radius       米                                 默认 0.014（黑点半径）
    lidar_post_length  米                                 默认 0.0783（示意支架，0=不画）
    use_yaw            true | false                        默认 true（画云台包络）
    show_rotation_marks true | false                       默认 true（画旋转标记，见上）

  ============================ 雷达挂在哪里 ============================
  MID-360 装在**云台**上（云台与底盘**同轴**，只有 yaw 一个自由度），所以 TF 是：

      base_link ── gimbal_yaw（绕 z，同一轴线）── <lidar_link>（fixed，斜装）

  云台一转，雷达跟着转；`sensor_scan_generation` 查 TF 时就会经 gimbal_yaw 把
  云台角一并算进去（云台角由 /joint_states 提供，必须真实且高频）。

  雷达本体中心在 base_link 系（**云台零位**，即上电车头朝前时）为
  (0.12081, -0.056721, 0.346388)：
    · 离车体中心水平 133.5 mm（偏前右）
    · 离地 346.4 mm；相对云台基座面（= 底盘顶面 0.26805）**只有 78.3 mm**
      —— 所以雷达实际是长在云台端面上的，不是插在底盘上的
    · 安装倾斜：roll 30°、yaw 63°（零位下雷达自身 x 轴的朝向；360° 雷达无所谓）

  调试用：`gimbal_fixed_yaw` 参数只在云台关节是 fixed 时生效，用它把云台"摆"到
  某个角度看几何关系（例：gimbal_fixed_yaw:=0.8），不需要 /joint_states。
-->
<robot name="srm_sentry" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================ 可覆盖参数 ============================ -->
  <!-- 坐标系契约 -->
  <xacro:arg name="root_frame"        default="base_link"/>
  <xacro:arg name="wheel_joint_type"  default="fixed"/>
  <xacro:arg name="gimbal_joint_type" default="fixed"/>

  <!-- 几何（默认值 = CAD 实测；model_builder 会用几何 YAML 的值覆盖，保证 SDF/URDF 同源） -->
  <xacro:arg name="chassis_radius"    default="0.2743"/>
  <xacro:arg name="chassis_length"    default="0.2353"/>
  <xacro:arg name="chassis_centre_z"  default="0.1504"/>
  <xacro:arg name="chassis_mass"      default="8.7"/>
  <xacro:arg name="wheel_radius"      default="0.07697"/>
  <xacro:arg name="wheel_width"       default="0.04576"/>
  <xacro:arg name="wheel_mass"        default="0.26"/>
  <xacro:arg name="wheel_effort"      default="1.0e+10"/>
  <xacro:arg name="wheel_velocity"    default="1.0e+10"/>
  <xacro:arg name="wheel_x"           default="0.166688"/>  <!-- 轮心 |x| -->
  <xacro:arg name="wheel_y"           default="0.166553"/>  <!-- 轮心 |y| -->
  <xacro:arg name="wheel_z"           default="0.076936"/>  <!-- 轮心离地高 -->
  <xacro:arg name="yaw_radius"        default="0.150"/>
  <xacro:arg name="yaw_length"        default="0.110"/>
  <xacro:arg name="yaw_mass"          default="2.0"/>

  <!-- 雷达 -->
  <xacro:arg name="lidar_link_name"   default="livox_frame"/>
  <xacro:arg name="lidar_mass"        default="0.25"/>
  <xacro:arg name="lidar_xyz"         default="0.12081 -0.056721 0.346388"/>
  <xacro:arg name="lidar_roll"        default="0.523598776"/>
  <xacro:arg name="lidar_pitch"       default="0"/>
  <xacro:arg name="lidar_yaw"         default="1.099557429"/>
  <xacro:arg name="lidar_radius"      default="0.014"/>
  <xacro:arg name="lidar_post_length" default="0.0783"/>
  <xacro:arg name="use_yaw"           default="true"/>
  <!-- 底盘/云台圆柱上的不对称旋转标记（侧壁竖条 + 顶面刻线 + 顶面小球）。
       两个圆柱都是旋转体，没有标记就看不出转没转，见文件头的说明。 -->
  <xacro:arg name="show_rotation_marks" default="true"/>
  <!-- 仅 gimbal_joint_type=fixed 时生效：把云台摆到该角度（弧度），纯用于看几何 -->
  <xacro:arg name="gimbal_fixed_yaw"  default="0"/>

  <!-- ============================ 几何常量 ============================ -->
  <xacro:property name="PI" value="3.141592653589793"/>

  <!-- CAD 基准：装配体里 base_link 离地高度（只在 root_frame=base_footprint 时用） -->
  <xacro:property name="cad_base_height"  value="0.1009"/>
  <!-- 下面所有几何量都按"地面 = 0"（base_link 原点在地面）给出，与几何 YAML 一致。
       默认取 CAD 实测值；model_builder 会用几何 YAML 的数值覆盖同名参数。 -->
  <xacro:property name="chassis_radius"   value="${float('$(arg chassis_radius)')}"/>
  <xacro:property name="chassis_length"   value="${float('$(arg chassis_length)')}"/>
  <xacro:property name="chassis_centre_z" value="${float('$(arg chassis_centre_z)')}"/>
  <xacro:property name="wx"               value="${float('$(arg wheel_x)')}"/>
  <xacro:property name="wy"               value="${float('$(arg wheel_y)')}"/>
  <xacro:property name="wz"               value="${float('$(arg wheel_z)')}"/>
  <xacro:property name="wheel_radius"     value="${float('$(arg wheel_radius)')}"/>
  <xacro:property name="wheel_width"      value="${float('$(arg wheel_width)')}"/>
  <xacro:property name="yaw_radius"       value="${float('$(arg yaw_radius)')}"/>
  <xacro:property name="yaw_length"       value="${float('$(arg yaw_length)')}"/>
  <xacro:property name="chassis_top"      value="${chassis_centre_z + chassis_length/2}"/> <!-- 0.26805 -->

  <xacro:property name="chassis_mass" value="${float('$(arg chassis_mass)')}"/>
  <xacro:property name="wheel_mass"   value="${float('$(arg wheel_mass)')}"/>
  <xacro:property name="yaw_mass"     value="${float('$(arg yaw_mass)')}"/>
  <xacro:property name="lidar_mass"   value="${float('$(arg lidar_mass)')}"/>
  <!-- 与几何 YAML 的 wheel.joint_effort / joint_velocity 保持一致 -->
  <xacro:property name="wheel_joint_effort"   value="${float('$(arg wheel_effort)')}"/>
  <xacro:property name="wheel_joint_velocity" value="${float('$(arg wheel_velocity)')}"/>

  <!-- 由 args 派生的开关 -->
  <xacro:property name="root_is_footprint" value="${'$(arg root_frame)' == 'base_footprint'}"/>
  <xacro:property name="wheels_move"       value="${'$(arg wheel_joint_type)' == 'continuous'}"/>
  <xacro:property name="gimbal_moves"      value="${'$(arg gimbal_joint_type)' == 'revolute'}"/>
  <!-- 画不画云台圆柱 / 旋转标记（容忍 true/True/1 这些写法） -->
  <xacro:property name="yaw_visible"
                  value="${'$(arg use_yaw)'.lower() in ('true', '1')}"/>
  <xacro:property name="rotation_marks_on"
                  value="${'$(arg show_rotation_marks)'.lower() in ('true', '1')}"/>
  <!-- root_frame=base_footprint 时整棵树下移 cad_base_height（世界高度不变） -->
  <xacro:property name="z_shift" value="${root_is_footprint * -cad_base_height}"/>
  <!-- 底盘圆柱底面高度（当前根坐标系下）；旋转标记的侧壁竖条/顶面刻线都从它算起。
       轮底 = 0，所以它 = chassis_centre_z - length/2（base_footprint 视图再加 z_shift） -->
  <xacro:property name="chassis_base_z" value="${chassis_centre_z - chassis_length/2 + z_shift}"/>

  <!-- 雷达安装位姿：xyz 按"地面=0"传入，再折算到当前根坐标系 -->
  <xacro:property name="lidar_xyz_parts"
                  value="${[float(value) for value in '$(arg lidar_xyz)'.split()]}"/>
  <xacro:property name="lidar_x" value="${lidar_xyz_parts[0]}"/>
  <xacro:property name="lidar_y" value="${lidar_xyz_parts[1]}"/>
  <xacro:property name="lidar_z" value="${lidar_xyz_parts[2] + z_shift}"/>
  <!-- 雷达相对云台基座面的高度（= 底盘顶面到雷达中心）。z_shift 在两边同时出现，
       相减自动抵消，所以 root_frame=base_footprint 时也成立。 -->
  <xacro:property name="lidar_z_rel" value="${lidar_xyz_parts[2] - chassis_top}"/>
  <xacro:property name="lidar_link" value="$(arg lidar_link_name)"/>
  <xacro:property name="lidar_post_len" value="${float('$(arg lidar_post_length)')}"/>
  <xacro:property name="lidar_post_radius" value="0.018"/>

  <!-- 惯量宏 -->
  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+l*l)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
             iyy="${2*m*r*r/5}" iyz="0"
             izz="${2*m*r*r/5}"/>
  </xacro:macro>

  <!-- ======================= 旋转标记（"看得出在不在转"） ======================= -->
  <!--
    绕 z 轴自转的圆柱体，转到哪个角度看起来都一样 —— 静止的圆柱和 5 rad/s 转着的
    圆柱在 RViz / Gazebo 里长得一模一样，底座和云台到底谁在转就看不出来了。
    所以给每个旋转体挂一组**不对称**标记，全部朝 +x（车头）：

      ① ${prefix}_mark_stripe  侧壁竖条，抬高 thick/2 贴在外壁上
                                —— 侧面视角：亮色带扫过 = 在转
      ② ${prefix}_mark_tick    顶面径向刻线（时针）
                                —— 俯视视角：指向哪里 = 转到哪个角
      ③ ${prefix}_mark_dot     刻线末端小球，缩得很小时也认得出来

    参数全部由圆柱自身尺寸派生（弧长 arc 换成弦长、高度内缩 4 mm 免得和端面打架）。
    ⚠ 三个都只有 visual、没有 collision：navigation footprint 与 Gazebo 动力学不变。
    ⚠ 调用点是 chassis_mark / gimbal_mark 这两条 display-only link，**不要**塞回
      base_link / gimbal_yaw：RViz2 每条 link 只认第一个 visual 的材质，塞回去就会被
      染成底盘灰/云台黄，颜色对比全失效。
    底盘的底色是灰的 → 用红；云台是半透明黄 → 用蓝，两种颜色互相对比，云台和底盘
    各自转起来一眼就能分开。
  -->
  <xacro:macro name="rotation_marks"
               params="prefix radius length base_z arc thick tick_in tick_out tick_w tick_t dot_r rgba">
    <xacro:property name="mk_r"      value="${float(radius)}"/>
    <xacro:property name="mk_l"      value="${float(length)}"/>
    <xacro:property name="mk_z0"     value="${float(base_z)}"/>
    <xacro:property name="mk_thick"  value="${float(thick)}"/>
    <!-- 弧长 → 弦长：贴在外壁上的那条带子的横向宽度 -->
    <xacro:property name="mk_chord"  value="${2.0 * mk_r * sin(float(arc) / (2.0 * mk_r))}"/>
    <xacro:property name="mk_height" value="${mk_l - 0.008}"/>
    <xacro:property name="mk_r_in"   value="${float(tick_in)}"/>
    <xacro:property name="mk_r_out"  value="${float(tick_out)}"/>
    <xacro:property name="mk_dot_r"  value="${float(dot_r)}"/>

    <!-- ① 侧壁竖条：外壁上一块亮色凸台（一半埋进圆柱，一半露出来） -->
    <visual name="${prefix}_mark_stripe">
      <origin xyz="${mk_r} 0 ${mk_z0 + mk_l / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${mk_thick} ${mk_chord} ${mk_height}"/>
      </geometry>
      <material name="${prefix}_mark_color">
        <color rgba="${rgba}"/>
      </material>
    </visual>

    <!-- ② 顶面径向刻线：从 tick_in 指到 tick_out，像一根时针，只会出现在 +x 方向 -->
    <visual name="${prefix}_mark_tick">
      <origin xyz="${(mk_r_in + mk_r_out) / 2.0} 0 ${mk_z0 + mk_l + float(tick_t) / 2.0}"
              rpy="0 0 0"/>
      <geometry>
        <box size="${mk_r_out - mk_r_in} ${float(tick_w)} ${float(tick_t)}"/>
      </geometry>
      <material name="${prefix}_mark_color">
        <color rgba="${rgba}"/>
      </material>
    </visual>

    <!-- ③ 刻线末端小球：坐在顶面上，缩得很小的时候就是那个"点" -->
    <visual name="${prefix}_mark_dot">
      <origin xyz="${mk_r_out - mk_dot_r} 0 ${mk_z0 + mk_l + mk_dot_r / 2.0}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${mk_dot_r}"/>
      </geometry>
      <material name="${prefix}_mark_color">
        <color rgba="${rgba}"/>
      </material>
    </visual>
  </xacro:macro>

  <!-- ============================ 根坐标系 ============================ -->
  <!-- 默认（root_frame=base_link）：base_link 就是根，原点在地面。
       root_frame=base_footprint 时才插一层地面系，把 base_link 抬到 CAD 的 0.1009。 -->
  <xacro:if value="${root_is_footprint}">
    <link name="base_footprint"/>
    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${cad_base_height}" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- ============================ 底盘 ============================ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${chassis_centre_z + z_shift}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:cylinder_inertia m="${chassis_mass}" r="${chassis_radius}" l="${chassis_length}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${chassis_centre_z + z_shift}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_length}"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.75 0.77 0.80 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_centre_z + z_shift}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_length}"/>
      </geometry>
    </collision>
    <!-- 旋转标记不在这里，见下面单独的 chassis_mark link（RViz 的一条 link 只认一种材质） -->
  </link>

  <!-- 旋转标记单独做成一个 **display-only link**（没有惯性、没有 collision，只挂在
       base_link 上显示）。原因：RViz2 的 RobotModel 显示插件对每个 link 只会用**第一个
       visual 的材质**给整条 link 上色 —— 把标记混在 base_link 里，它们会被涂成底盘的同
       一种灰，红蓝对比就全废了；单独一条 link 才拿得到自己的颜色。
       Gazebo（SDF）是按 visual 上材质的，所以 model_builder 生成 SDF 时不需要拆 link。
       代价只是 TF 树里多一个固定的叶子 frame，和 livox_imu / livox_scan 一样。 -->
  <xacro:if value="${rotation_marks_on}">
    <link name="chassis_mark">
      <xacro:rotation_marks prefix="chassis"
                            radius="${chassis_radius}" length="${chassis_length}"
                            base_z="${chassis_base_z}"
                            arc="0.055" thick="0.012"
                            tick_in="${yaw_radius + 0.012}"
                            tick_out="${chassis_radius - 0.008}"
                            tick_w="0.030" tick_t="0.010" dot_r="0.016"
                            rgba="0.90 0.13 0.10 1.0"/>
    </link>
    <joint name="chassis_mark_joint" type="fixed">
      <parent link="base_link"/>
      <child link="chassis_mark"/>
      <!-- 零偏移：标记的数就是按 base_link 系写的（含 root_frame=base_footprint 的 z_shift） -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- ============================ 四个小轮 ============================ -->
  <!--
    轮轴沿车体对角（X 型全向轮布局）：圆柱先绕 x 转 -90° 使轴水平，再绕 z 转到对角线。
      wheel_front_left / wheel_rear_right  沿 +45°
      wheel_rear_left  / wheel_front_right 沿 135°
    rpy_yaw 只影响**外观**；关节轴由 axis_yaw 算出的 (cos, sin, 0) 给出，与 SDF 里
    同名关节的轴向完全一致（仿真按 SDF 的关节名发 /joint_states）。
  -->
  <xacro:macro name="omni_wheel" params="name x y axis_yaw rpy_yaw">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${-PI/2} 0 ${rpy_yaw}"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.08 0.08 0.10 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-PI/2} 0 ${rpy_yaw}"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <!-- 实车用 fixed（没有 /joint_states）；仿真用 continuous（名字与 SDF 一致） -->
    <xacro:if value="${wheels_move}">
      <joint name="${name}_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${name}"/>
        <origin xyz="${x} ${y} ${wz + z_shift}" rpy="0 0 0"/>
        <axis xyz="${cos(axis_yaw)} ${sin(axis_yaw)} 0"/>
        <limit lower="-1.7976931348623157e+308" upper="1.7976931348623157e+308"
               effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}"/>
        <dynamics damping="0.1" friction="0.05"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${wheels_move}">
      <joint name="${name}_joint" type="fixed">
        <parent link="base_link"/>
        <child link="${name}"/>
        <origin xyz="${x} ${y} ${wz + z_shift}" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <gazebo reference="${name}">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:omni_wheel name="wheel_front_left"  x="${ wx}" y="${ wy}"
                    axis_yaw="${ PI/4}" rpy_yaw="${-PI/4}"/>
  <xacro:omni_wheel name="wheel_rear_left"   x="${-wx}" y="${ wy}"
                    axis_yaw="${3*PI/4}" rpy_yaw="${ PI/4}"/>
  <xacro:omni_wheel name="wheel_front_right" x="${ wx}" y="${-wy}"
                    axis_yaw="${-PI/4}" rpy_yaw="${-3*PI/4}"/>
  <xacro:omni_wheel name="wheel_rear_right"  x="${-wx}" y="${-wy}"
                    axis_yaw="${ PI/4}" rpy_yaw="${3*PI/4}"/>

  <!-- ============================ 云台示意包络 ============================ -->
  <!-- link 始终存在（保证 TF 稳定、名字可被引用），use_yaw=false 时只是不画。 -->
  <xacro:if value="${gimbal_moves}">
    <joint name="gimbal_yaw_joint" type="revolute">
      <parent link="base_link"/>
      <child link="gimbal_yaw"/>
      <origin xyz="0 0 ${chassis_top + z_shift}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-PI}" upper="${PI}" effort="30" velocity="10"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:if>
  <xacro:unless value="${gimbal_moves}">
    <joint name="gimbal_yaw_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gimbal_yaw"/>
      <!-- rpy 只为调试：把云台摆到 gimbal_fixed_yaw（正式运行时保持 0） -->
      <origin xyz="0 0 ${chassis_top + z_shift}" rpy="0 0 ${float('$(arg gimbal_fixed_yaw)')}"/>
    </joint>
  </xacro:unless>

  <link name="gimbal_yaw">
    <inertial>
      <origin xyz="0 0 ${yaw_length/2}" rpy="0 0 0"/>
      <mass value="${yaw_mass}"/>
      <xacro:cylinder_inertia m="${yaw_mass}" r="${yaw_radius}" l="${yaw_length}"/>
    </inertial>
    <xacro:if value="${yaw_visible}">
      <visual>
        <origin xyz="0 0 ${yaw_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${yaw_radius}" length="${yaw_length}"/>
        </geometry>
        <!-- 半透明：半径 150 mm 会把离轴 133.5 mm 的雷达包进去，透明才看得见 -->
        <material name="yaw_yellow">
          <color rgba="0.95 0.80 0.25 0.45"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${yaw_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${yaw_radius}" length="${yaw_length}"/>
        </geometry>
      </collision>
      <!-- 旋转标记不在这里，见下面单独的 gimbal_mark link（同 chassis_mark 的理由） -->
    </xacro:if>
  </link>

  <!-- 云台的旋转标记（蓝色，与底盘的红色区分开），同样做成 display-only link，
       挂在 gimbal_yaw 下面：云台单独转（云台角来自 /joint_states，只有
       gimbal_joint_type=revolute 时才动）时，蓝标记会相对红标记错开一个角度，
       "底盘在转还是云台在转"一眼就分得清。 -->
  <xacro:if value="${yaw_visible and rotation_marks_on}">
    <link name="gimbal_mark">
      <xacro:rotation_marks prefix="gimbal"
                            radius="${yaw_radius}" length="${yaw_length}"
                            base_z="0"
                            arc="0.045" thick="0.010"
                            tick_in="0.020"
                            tick_out="${yaw_radius - 0.006}"
                            tick_w="0.024" tick_t="0.008" dot_r="0.014"
                            rgba="0.05 0.45 1.0 1.0"/>
    </link>
    <joint name="gimbal_mark_joint" type="fixed">
      <parent link="gimbal_yaw"/>
      <child link="gimbal_mark"/>
      <!-- 零偏移：标记的数就是按 gimbal_yaw 系写的（底面 = 云台基座面） -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- ============================ 雷达 ============================ -->
  <!-- 雷达长在云台上：parent 是 gimbal_yaw，origin 相对**云台基座面**给出
       （z = 雷达离地 0.346388 − 底盘顶面 0.26805 = 0.078338）。
       关节名与 SDF 的 <joint name="gimbal_yaw_to_<link_name>"> 一致。 -->
  <joint name="gimbal_yaw_to_${lidar_link}" type="fixed">
    <parent link="gimbal_yaw"/>
    <child link="${lidar_link}"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z_rel}"
            rpy="$(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)"/>
  </joint>

  <link name="${lidar_link}">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <xacro:sphere_inertia m="${lidar_mass}" r="$(arg lidar_radius)"/>
    </inertial>
    <!-- 安装支架（对应 STEP 里那块雷达安装板）：沿雷达自身 -z 伸出，随雷达一起倾斜 -->
    <xacro:if value="${lidar_post_len > 0}">
      <visual>
        <origin xyz="0 0 ${-lidar_post_len/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_post_radius}" length="${lidar_post_len}"/>
        </geometry>
        <material name="bracket_grey">
          <color rgba="0.72 0.70 0.78 1.0"/>
        </material>
      </visual>
    </xacro:if>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="$(arg lidar_radius)"/>
      </geometry>
      <material name="lidar_dot">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="$(arg lidar_radius)"/>
      </geometry>
    </collision>
  </link>

</robot>
