<?xml version="1.0" encoding="UTF-8"?>
<!-- 带 SmoothPath 的多目标导航行为树（TDT 完整链路：YAstar + MinimumSnap）。

     基于 navigate_through_poses_route_aware.xml（自研 RemovePassedGoalsByRoute 删点
     逻辑的完整说明见那份文件），共三处改动：

     1) ComputePathThroughPoses 之后插入 SmoothPath：
        TDT YAstar 输出稀疏路径（launch 注入 path_resample_step 0.20 后为 0.2 m 间距），
        MinimumSnap 平滑后交给控制器的是连续曲线；SmoothPath 失败时 TdtSmoother 的
        fallback_to_resampled 会返回加密折线，FollowPath 不缺前视点。

     2) RateController 3.0 -> 0.2 Hz：SmoothPath 耗时 ~0.6 s，1 Hz 重规划会把
        {smoothed_path} 每秒覆盖一次、FollowPath 随之重置，progress checker 开不满
        窗口（与 navigate_to_pose_w_smoothing.xml 2026-11-16 实测同因）。
        局部避障不受影响：MINCO 本地 10 Hz 重规划。

     3) 移除 BackUp（与 navigate_to_pose_w_smoothing.xml 安全版策略一致）：
        规划/平滑失败只清代价地图重试，绝不主动给速度；重试 3 次仍失败就让目标
        ABORT，由人检查现场后再决定。恢复"脱困推车"时从 route_aware 版拷回。 -->
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateRecovery"
                  number_of_retries="3">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="0.2">
          <Sequence name="PlanAndSmooth">
            <RecoveryNode name="ComputePathThroughPoses"
                          number_of_retries="3">
              <ReactiveSequence>
                <RemovePassedGoalsByRoute input_goals="{goals}"
                                          output_goals="{goals}"
                                          radius="0.60"
                                          approach_radius="1.0"
                                          route_margin="0.30"
                                          keep_last="true"/>
                <ComputePathThroughPoses goals="{goals}"
                                         path="{path}"
                                         planner_id="GridBased"/>
              </ReactiveSequence>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                  service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
            <!-- 两套参数各注册一个平滑器，留空由 Nav2 选用该实例。
                 check_for_collisions=false（2026-11-22 实车）：nav2 的 footprint 检查
                 (0.15m 圆盘 vs 253) 与 planner 252 口径矛盾 —— 现场档2 inflation 只有
                 0.16，planner 给出的合法路径贴 253 边缘时该检查必撞（实测 11-22 北走廊
                 首目标 ABORT 全部卡在这）。贴墙安全由 MINCO 的 ESDF 硬校验
                 (safety 0.245) + path_centering(0.20) 兜底，组合与仿真 11-09 v4
                 （252 严格平滑 + collision off）一致。 -->
            <SmoothPath smoother_id=""
                        unsmoothed_path="{path}"
                        smoothed_path="{smoothed_path}"
                        max_smoothing_duration="1.0"
                        check_for_collisions="false"/>
          </Sequence>
        </RateController>
        <RecoveryNode name="FollowPath"
                      number_of_retries="10">
          <FollowPath path="{smoothed_path}"
                      controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <!-- 只清代价地图，不产生任何速度（安全版，见文件头说明）。 -->
        <Sequence name="ClearingActions">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
                              service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
