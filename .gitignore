# ROS 2 / colcon output
/build/
/install/
/log/
/devel/
/.cache/
/.roslog/
/log_diag/
/**/__pycache__/
*.py[cod]
# colcon 的临时日志：若某次把 ROS_LOG_DIR 指到工作区内（例如 build/），
# 日志会堆在 build 下而不是 log/，上面 `/log_diag/` 之类规则盖不住它。
/build/roslog/

# Runtime data and logs
*.log
*.db3
*.mcap
*.bag
*.bag2
*.pcap
*~


# Local editor files
.vscode/
tmp/
.idea/

# 本地测试/仿真产生的运行时目录。
# 这两项此前没有规则覆盖：内容虽小但每次跑测试或仿真脚本都会重新生成，
# 放任它们变成未跟踪文件，容易被 `git add -A` 误提交。
/.pytest_cache/
/.sim_run/

# Generated map and visualization artifacts
/*.pcd
/src/srm27_navigation/point_lio/PCD/*.pcd
/*.pgm
/*.gv
/*.pdf
# 图像编辑器/地图工具处理过程中留下的备份件（如 GIMP 另存 pgm 时的 .pgm.orig）
*.pgm.orig

# 以下三条原先由 src/srm27_navigation/.gitignore 提供。该文件已作为冗余文件删除，
# 规则上提到此统一维护，避免本地实车地图产物变成未跟踪文件而被误提交。
/src/srm27_navigation/srm27_nav_bringup/pcd/**/*.pcd
/src/srm27_navigation/srm27_nav_bringup/map/real/*.yaml
/src/srm27_navigation/srm27_nav_bringup/map/real/*.pgm

symlink
sentry_*/

# Cartographer raw map artifacts (大体积二进制，默认不跟踪)
*.posegraph
*.data
# 例外：随地图一起版本化的原始产物仍要跟踪（main 已提交 maps/227_1006/ 下的
# .data 与 .posegraph；没有这两条否定规则，它们会在这里被静默丢弃）
!maps/**/*.data
!maps/**/*.posegraph

# 现场测试产物（波形图/CSV/日志片段），随时可删，不进版本库；
# 需要保留的结论请写进 docs/。
/user_test_log/

# 临时工作目录（抓取的参考文章/图片、解包的第三方仓库等），仅供本地查阅，
# 不属于工程产物，随时可删，不进版本库。
/.rm_scratch/

# 现场扫图的大点云（maps/pcd/*.pcd 单份动辄 200 MB+，超过 GitHub 单文件 100 MB 上限，
# push 会被 pre-receive 直接拒收）。默认只留本地，需要版本化的请走 Release 附件或 Git LFS。
# 注：此规则只拦新增文件；227_1011*.pcd 等已跟踪的老文件不受影响。
maps/pcd/*.pcd

# ---------------------------------------------------------------------------
# 2026-11-14 工作区清理：运行数据/实验产物统一移出源码树
# 默认根目录：~/srm_nav_27_data/（SRM27_DATA_DIR 可覆盖）
# 这些规则只防误提交；真正长期保留的数据放工作区外。
# ---------------------------------------------------------------------------
/data/
/artifacts/
/log_diag/
/.mapcheck/
/.tmp_diag/
/.tmp_roslog/
/.rm_scratch/
/.sim_run/
/**/.pytest_cache/

# Point-LIO 生成点云：源码包只保留说明文件
/src/srm27_navigation/point_lio/PCD/*
!/src/srm27_navigation/point_lio/PCD/readme.md
