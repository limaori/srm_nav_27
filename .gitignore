# ROS 2 / colcon output
/build/
/install/
/log/
/devel/
/.cache/
/.roslog/
/log_diag/
/**/__pycache__/
*.py[cod]

# Runtime data and logs
*.log
*.db3
*.mcap
*.bag
*.bag2
*.pcap
*~


# Local editor files
.vscode/
tmp/
.idea/

# Generated map and visualization artifacts
/*.pcd
/src/srm27_navigation/point_lio/PCD/*.pcd
/*.pgm
/*.gv
/*.pdf

# 以下三条原先由 src/srm27_navigation/.gitignore 提供。该文件已作为冗余文件删除，
# 规则上提到此统一维护，避免本地实车地图产物变成未跟踪文件而被误提交。
/src/srm27_navigation/srm27_nav_bringup/pcd/**/*.pcd
/src/srm27_navigation/srm27_nav_bringup/map/real/*.yaml
/src/srm27_navigation/srm27_nav_bringup/map/real/*.pgm

symlink
sentry_*/

# Cartographer raw map artifacts (大体积二进制，默认不跟踪)
*.posegraph
*.data
# 例外：随地图一起版本化的原始产物仍要跟踪（main 已提交 maps/227_1006/ 下的
# .data 与 .posegraph；没有这两条否定规则，它们会在这里被静默丢弃）
!maps/**/*.data
!maps/**/*.posegraph

